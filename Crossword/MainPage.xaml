<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Crossword.Views"
             xmlns:utils="clr-namespace:Crossword.Utils"
             xmlns:controls="clr-namespace:Crossword.Controls"
             BackgroundColor="Wheat"
             x:Class="Crossword.MainPage">
    <ContentPage.BindingContext>
        <views:MainPageView x:Name="view"/>
    </ContentPage.BindingContext>
    <ScrollView>
        <VerticalStackLayout>
            <!--LettersView-->
            <!--<Grid ColumnDefinitions="*,*,*,*,*,*,*,*,*" 
                  RowDefinitions="*,*,*" 
                  BindableLayout.ItemsSource="{Binding Letters}" 
                  HorizontalOptions="Center"
                  BackgroundColor="Transparent">
                <BindableLayout.ItemTemplate >
                    <DataTemplate >
                        --><!--<Border Background="Black" 
                    Grid.Column="{Binding X}"
                    Grid.Row="{Binding Y}"
                    HorizontalOptions="Start"
                    VerticalOptions="Start" 
                    MinimumWidthRequest="20" 
                    MinimumHeightRequest="20">--><!--
                        <Button Text="{Binding Name}"
                                     Grid.Column="{Binding X}"
                                     Grid.Row="{Binding Y}"
                                   CornerRadius="0"  
                    TextColor="Black"
                    Background="White"
                    BorderColor="Transparent"
                    BorderWidth="2"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Command="{Binding Clickced}"
                    CommandParameter="{Binding SelectedExcercie ,Source={x:Reference view}}"
                   />

                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </Grid>-->
            
            <controls:Keyboard x:Name="keyboard"
                           HorizontalOptions="Center"
                           Margin="0,10,0,0"
                           GridColumns="9"
                           GridRows="3"
                           Keys="{Binding Letters}"
                           LetterCommand="{Binding Clickced}"/>
            
            <!--CrosswordView-->
            
            <CollectionView ItemsSource="{Binding Excercies}"
                             ItemSizingStrategy="MeasureAllItems"
                            VerticalScrollBarVisibility="Never"
                            ItemsUpdatingScrollMode="KeepItemsInView"
                            Margin="0,10,0,0">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="5" 
                              ColumnDefinitions="*,*"
                              RowDefinitions="*"
                              VerticalOptions="Center">
                            <Grid utils:GridHelpers.ColumnCount="{Binding GridColumnCount}"
                              BindableLayout.ItemsSource="{Binding Answer}"
                              Grid.Column="0"
                              VerticalOptions="Center"
                              HorizontalOptions="Center"
                              x:Name="gridExcercie">

                                <BindableLayout.ItemTemplate >
                                    <DataTemplate >
                                        <Button Text="{Binding Character}"
                                          CornerRadius="0"
                                            BorderColor="White"
                                            BorderWidth="1"
                                          Grid.Column="{Binding Index}"
                                          HorizontalOptions="Center"
                                          VerticalOptions="Center"
                                          FontSize="20"
                                          
                                          Background="Black"
                                          TextColor="White"
                                          Command="{Binding FocuseButton,Source={x:Reference view}}"
                                          CommandParameter="{Binding BindingContext ,Source={x:Reference gridExcercie}}"
                                            />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate >
                            </Grid>
                            <Label Text="{Binding Question}" 
                                       TextColor="White" 
                                       BackgroundColor="Transparent" 
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center"
                                       FontSize="Body" Grid.Column="1"/>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>


        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
