<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Crossword.Controls.TopicView"
             x:Name="contentView">
    <Grid ColumnDefinitions="*,*"
                   RowDefinitions="*"
          BindingContext="{Binding TopicViewProperty,Source={x:Reference contentView}}">
        <Label Text="{Binding Topic}"/>
        <Button Text="Remove"
                    IsVisible="{Binding IsVisableRemoveButton,Source={x:Reference view}}" 
                         Command="{Binding TopicCommand,Source={x:Reference view}}"
                         CommandParameter="{Binding .}"
                         Grid.Column="1">
            <Button.Triggers>
                <DataTrigger
                             TargetType="Button"
                             Binding="{Binding IsToRemove}"
                             Value="True">
                    <Setter Property="BackgroundColor" Value="Red"/>
                </DataTrigger>
            </Button.Triggers>
        </Button>
    </Grid>
</ContentView>
