<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Crossword.Controls.TopicControl"
             x:Name="contentView">
    <Grid ColumnDefinitions="*,*"
          RowDefinitions="*">
        <Label Text="{Binding Topic,Source={x:Reference contentView}}"/>
        <Button Text="Remove"
                    IsVisible="{Binding IsVisibleRemoveButton,Source={x:Reference contentView}}" 
                         Command="{Binding TopicCommand,Source={x:Reference contentView}}"
                         CommandParameter="{Binding .}"
                         Grid.Column="1">
            <Button.Triggers>
                <DataTrigger
                             TargetType="Button"
                             Binding="{Binding IsToRemove,Source={x:Reference contentView}}"
                             Value="True">
                    <Setter Property="BackgroundColor" Value="Red"/>
                </DataTrigger>
            </Button.Triggers>
        </Button>
    </Grid>
</ContentView>
