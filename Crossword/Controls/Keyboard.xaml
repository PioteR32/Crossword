    <VerticalStackLayout
       BindableLayout.ItemsSource="{Binding LetterViews, Source={x:Reference root}}"
       HorizontalOptions="Center"
       BackgroundColor="Transparent">
        <BindableLayout.ItemTemplate >
            <DataTemplate >
                <HorizontalStackLayout
                    BindableLayout.ItemsSource="{Binding .}"
                    HorizontalOptions="Center"
                    BackgroundColor="Transparent">
                    <BindableLayout.ItemTemplate >
                        <DataTemplate >
                            <Button Text="{Binding Name}"
                                Grid.Column="{Binding X}"
                                Grid.Row="{Binding Y}"
                                CornerRadius="0"  
                                TextColor="Black"
                                Background="White"
                                BorderColor="Transparent"
                                BorderWidth="2"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                Command="{Binding LetterCommand ,Source={x:Reference root}}"
                                CommandParameter="{Binding .}"
                                 />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                 </HorizontalStackLayout>
            </DataTemplate>
        </BindableLayout.ItemTemplate>
    </VerticalStackLayout>
