<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:utils="clr-namespace:Crossword.Utils"
             x:Class="Crossword.Controls.Keyboard">
    <Grid
        utils:GridHelpers.ColumnCount="9"
        utils:GridHelpers.RowCount="3"
       
       HorizontalOptions="Center"
       BackgroundColor="Transparent">
        <BindableLayout.ItemTemplate >
            <DataTemplate >
                <!--<Border Background="Black" 
         Grid.Column="{Binding X}"
         Grid.Row="{Binding Y}"
         HorizontalOptions="Start"
         VerticalOptions="Start" 
         MinimumWidthRequest="20" 
         MinimumHeightRequest="20">-->
                <Button Text="{Binding Name}"
                          Grid.Column="{Binding X}"
                          Grid.Row="{Binding Y}"
                        CornerRadius="0"  
         TextColor="Black"
         Background="White"
         BorderColor="Transparent"
         BorderWidth="2"
         HorizontalOptions="Center"
         VerticalOptions="Center"
         Command="{Binding Clickced}"
         CommandParameter="{Binding SelectedExcercie ,Source={x:Reference view}}"
        />

            </DataTemplate>
        </BindableLayout.ItemTemplate>
    </Grid>
</ContentView>
