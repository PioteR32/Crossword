<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Crossword.Views"
             xmlns:utils="clr-namespace:Crossword.Utils"
             xmlns:controls="clr-namespace:Crossword.Controls"
             xmlns:converters="clr-namespace:Crossword.Converters"
             x:Class="Crossword.Pages.AddCrosswordKeysPage"
             Title="AddCrosswordKeysPage"
             BackgroundColor="Wheat"
             x:Name="view"
             >
    <ContentPage.BindingContext >
        <views:AddCrosswordKeyPageView />
    </ContentPage.BindingContext>
    
    <ContentPage.Triggers>
        <DataTrigger TargetType="ContentPage"
                     Binding="{Binding UserDeletingExcercies}"
                     Value="True"
                     >
            <Setter Property="BackgroundColor" Value="Gray"/>
        </DataTrigger>
    </ContentPage.Triggers>

    <ScrollView>
    <VerticalStackLayout>
        
        <Entry Placeholder="Question" Text="{Binding Question}"/>
        <Entry Placeholder="Answer" Text="{Binding Answer}"/>

        <Button Text="Add new crosword excercie" Command="{Binding AddEcxcercieCommand}"/>
        <Button Text="Remove excercie" Command="{Binding DeleteEcxcerciesCommand}"/>
        <Button Text="Delete Changes" Command="{Binding DeleteChangesCommand}"/>
        <Button Text="Save Changes" Command="{Binding SaveChangesCommand}"/>
        <CollectionView ItemsSource="{Binding Topics}" HeightRequest="100">
            <CollectionView.Header>
                <Label HorizontalOptions="Center" Text="Choose Topics"/>
            </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Button Text="{Binding Topic}" 
                            Command="{Binding BindingContext.AddingTopicToExcercie,Source={x:Reference view}}" 
                            CommandParameter="{Binding .}"
                            BackgroundColor="Transparent">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button"
                                         Binding="{Binding IsChecked}"
                                         Value="True">
                                <Setter Property="BackgroundColor" Value="Red"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <CollectionView ItemsSource="{Binding Excercies}" HeightRequest="100" Margin="20">
            <CollectionView.Header>
                <Grid ColumnDefinitions="*,*,*"
                      RowDefinitions="*">
                    <Label Text="Question"/>
                    <Label Text="Answer" Grid.Column="1"/>
                </Grid>
            </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout>
                            <Grid ColumnDefinitions="*,*,*"
                                RowDefinitions="*"
                                  x:Name="excercieView">
                                <Entry Text="{Binding QuestionView}" x:Name="firstEntry"/>
                                <Entry Text="{Binding CorrectAnswerView}" Grid.Column="1"/>
                                <Button Text="Remove"
                                        IsVisible="{Binding BindingContext.UserDeletingExcercies,Source={x:Reference view}}" 
                                        Command="{Binding BindingContext.AddToDeleteEcxcercieCommand,Source={x:Reference view}}"
                                        CommandParameter="{Binding .}"
                                         Grid.Column="2">
                                    <Button.Triggers>
                                        <DataTrigger
                                                TargetType="Button"
                                                Binding="{Binding IsToRemove}"
                                                Value="True">
                                            <Setter Property="BackgroundColor" Value="Red"/>
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                            </Grid>


                            <Grid ColumnDefinitions="*,*"
                                    RowDefinitions="*">
                                <Button Text="Add Topic" 
                                        Command="{Binding AddTopicCommand}"
                                        CommandParameter="{Binding BindingContext.Topics,Source={x:Reference view}}"/>
                                <Button Text="Remove excercie" 
                                        Command="{Binding DeleteTopicCommand}"
                                        Grid.Column="1"/>

                            </Grid>
                            <CollectionView ItemsSource="{Binding TopicsView}" HeightRequest="100">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <controls:TopicControl
                                        Topic="{Binding Topic}"
                                        IsToRemove="{Binding IsToRemove}"
                                        IsVisibleRemoveButton="{Binding IsVisibleButton}"
                                        TopicCommand="{Binding BindingContext.AddToDeleteTopicCommand, Source={x:Reference excercieView}}"
                                        />
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
    </ScrollView>
</ContentPage>