<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Crossword.Views"
             xmlns:utils="clr-namespace:Crossword.Utils"
             xmlns:controls="clr-namespace:Crossword.Controls"
             xmlns:converters="clr-namespace:Crossword.Converters"
             BackgroundColor="Wheat"
             x:Class="Crossword.MainPage">
    <ContentPage.BindingContext>
        <views:MainPageView x:Name="view"/>
    </ContentPage.BindingContext>
    <ScrollView>
        <VerticalStackLayout>
            <Button Text="Add Keys To Crosswords" Command="{Binding GoToAddCrosswordPageKeysCommand}"/>
            <Entry
                Placeholder="Enter Topic Name" 
                Text="{Binding NameOfNewCrossword}"/>
            <Entry
                Placeholder="Enter Password"
                Text="{Binding PasswordForNewCrossword}"/>
            <Button Text="Add new Crossword" Command="{Binding AddNewCrosswordCommand}"/>
            <CollectionView ItemsSource="{Binding Crosswords}"
                             ItemSizingStrategy="MeasureAllItems"
                             VerticalScrollBarVisibility="Never"
                             ItemsUpdatingScrollMode="KeepItemsInView"
                             Margin="0,10,0,0">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="*,*" >
                            <Button Text="{Binding Name}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type views:MainPageView}}, Path=GoToCrosswordPageCommand}"
                                    CommandParameter="{Binding .}"
                                    Grid.Column="1"
                                    HorizontalOptions="End"
                                    VerticalOptions="Center"
                                    FontSize="20"/>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
