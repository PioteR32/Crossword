<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Crossword.Views"
             xmlns:utils="clr-namespace:Crossword.Utils"
             xmlns:controls="clr-namespace:Crossword.Controls"
             xmlns:converters="clr-namespace:Crossword.Converters"
             BackgroundColor="Wheat"
             x:Class="Crossword.MainPage">
    <ContentPage.BindingContext>
        <views:MainPageView x:Name="view"/>
    </ContentPage.BindingContext>
    <ScrollView>
        <VerticalStackLayout>
            <Button Text="Add Keys To Crosswords" Command="{Binding GoToAddCrosswordPageKeys}"/>
            <Button Text="Go to Crossword" Command="{Binding GoToCrosswordPage}"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
